functional-code":{"insertions":2,"deletions":5}}},{"hash":"26490b465e7700c1dc0d73d004fb608eec93ef50","isMergeCommit":false,"messageTitle":"Improve priority feature using existing commands","messageBody":"Integrate priority tagging into add and edit\nEliminate redundant mark command\nImprove usability and consistency of command interface\n","fileTypesAndContributionMap":{"functional-code":{"insertions":77,"deletions":163},"other":{"insertions":13,"deletions":12},"test-code":{"insertions":7,"deletions":6}}}]},{"date":"2026-03-19T00:00:00","commitResults":[{"hash":"473b4f783a7425499e8f78986bd93faf8239ec87","isMergeCommit":true,"messageTitle":"Merge pull request #70 from KeeZhiSong/update-ug-#69","messageBody":"","fileTypesAndContributionMap":{}}]},{"date":"2026-03-23T00:00:00","commitResults":[{"hash":"9abbc7cf68470c6f018305473b8c7243d6a319ac","isMergeCommit":true,"messageTitle":"Merge pull request #80 from r-a-y-y-a/branch-Redo","messageBody":"","fileTypesAndContributionMap":{}}]}],"KeeZhiSong":[{"date":"2026-03-04T00:00:00","commitResults":[{"hash":"2b8c835699cfa3472809a746360131daa4ff5b83","isMergeCommit":false,"messageTitle":"docs: add photo for KeeZhiSong","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":5}}}]},{"date":"2026-03-05T00:00:00","commitResults":[{"hash":"2655181f95f140a4f46de2cd38b25780b0eb0c42","isMergeCommit":false,"messageTitle":"docs: update AboutUs for KeeZhiSong","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":6}}}]},{"date":"2026-03-10T00:00:00","commitResults":[{"hash":"f452b605ce307750c8a2d2190b3738d2d926ca4d","isMergeCommit":false,"messageTitle":"feat: Add list command to display all candidates","messageBody":"The existing list command only shows \"Listed all persons\" with no\nsorting or count information.\n\nRecruiters need to view all candidates sorted alphabetically with a\nsummary count to quickly review their pipeline.\n\nLet\u0027s:\n* Update ListCommand to sort candidates alphabetically (case-insensitive)\n* Show candidate count summary: \"Listed X candidate(s).\"\n* Show friendly message when no candidates exist\n* Add ListCommandParser to reject extra parameters\n* Add sortFilteredPersonList to Model, ModelManager, AddressBook, and\n  UniquePersonList\n* Update tests to match new behavior\n\nThis gives recruiters a clear, organized view of their candidate pool.\n\nCo-Authored-By: Claude Opus 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":77,"deletions":4},"test-code":{"insertions":79,"deletions":4}}}]},{"date":"2026-03-11T00:00:00","commitResults":[{"hash":"1429267d9620fb45262b718d721c95672e8c1d19","isMergeCommit":false,"messageTitle":"feat: Update add command with improved validation","messageBody":"The add command uses basic validation that accepts digits in\nnames, has no phone format standard, and gives generic error\nmessages when required fields are missing.\n\nLet\u0027s:\n* Update Name to reject digits and allow hyphens, apostrophes,\n  periods, and slashes (max 100 chars)\n* Update Phone to follow E.164 format with optional + prefix\n  and 3-15 digit range\n* Update Email to enforce max 254 character length\n* Add specific error messages for each missing required field\n* Update display format to use \" | \" separator\n* Collapse multiple whitespace in names to single space\n* Update all related tests for new validation rules\n\nThis improves data quality and gives users clearer feedback\nwhen input is invalid or incomplete.\n\nCo-Authored-By: Claude Opus 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":73,"deletions":22},"test-code":{"insertions":31,"deletions":31}}}]},{"date":"2026-03-19T00:00:00","commitResults":[{"hash":"b14b3c8ce24e769a77ecc6b3cc2e4fd2225c184f","isMergeCommit":true,"messageTitle":"Merge pull request #64 from therealniru/branch-priority-tag","messageBody":"Add priority tag command","fileTypesAndContributionMap":{}},{"hash":"6bd54a405233b8587a4f19229040f23977fa0657","isMergeCommit":false,"messageTitle":"docs: Update User Guide with new features for v1.4","messageBody":"- Rename app references from AddressBook to Talently\n- Update add command with name/phone/email validation constraints\n- Update list command to note alphabetical sorting and count display\n- Update edit command to include pr/PRIORITY field\n- Rename delete to remove throughout\n- Add reject command (reject INDEX r/REASON)\n- Add sort command (sort date o/ORDER)\n- Add tagpool command for managing master tag registry\n- Add tag command for assigning tags to candidates\n- Update command summary table with all new commands\n\nCloses #69\n\nCo-Authored-By: Claude Sonnet 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"docs":{"insertions":121,"deletions":66}}}]},{"date":"2026-03-24T00:00:00","commitResults":[{"hash":"cfe719e418cfa95505217a4ae02237b840b156ad","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into fixUndo","messageBody":"","fileTypesAndContributionMap":{}}]}],"shrievarshanbaskar":[{"date":"2026-03-05T00:00:00","commitResults":[{"hash":"022d38b7f03440352ba82df2b9f7344bd731bfac","isMergeCommit":false,"messageTitle":"Add Shrievarshan photo","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":5}}},{"hash":"01b640bbf244d11e4e3b981ed5762acb8fa26761","isMergeCommit":true,"messageTitle":"Merge pull request #20 from shrievarshanbaskar/add-shrie-photo","messageBody":"Add Shrievarshan photo","fileTypesAndContributionMap":{}},{"hash":"67ab5d6b440ceec5b56c134edff2e78245dcf8f4","isMergeCommit":false,"messageTitle":"Update UserGuide with additional tip","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":20,"deletions":0},"docs":{"insertions":1,"deletions":0}}},{"hash":"b12eab32f90c9cbccec7dd7d89f5bd743cd2e753","isMergeCommit":false,"messageTitle":"Remove IDE files","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":0,"deletions":20}}}]},{"date":"2026-03-11T00:00:00","commitResults":[{"hash":"73b2bf7eadd37ba1320c5c44c2381a17cd005f0b","isMergeCommit":true,"messageTitle":"Merge pull request #44 from AK-matrix/branch-add-candidate-search","messageBody":"FindCommand: Implement candidate search","fileTypesAndContributionMap":{}},{"hash":"17b965c8dc0f500057229cea4a87c52f38d0b1a6","isMergeCommit":false,"messageTitle":"Person: Add status and rejection tracking fields","messageBody":"Person model currently has no way to track candidate\nrejection status or store rejection history.\n\nThe upcoming reject command requires a status field and\na chronological list of rejection reasons on each Person.\n\nLet\u0027s add a Status enum (NONE, REJECTED, ARCHIVED),\na RejectionReason value object with validation, and\nextend Person with these new fields. The JSON storage\nlayer, EditCommand, and test utilities are updated to\npreserve backward compatibility by defaulting to\nStatus.NONE with an empty rejection list.\n\nCo-Authored-By: Claude Opus 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":216,"deletions":6},"test-code":{"insertions":63,"deletions":11}}},{"hash":"f686b1607430740592482934e21bb29a3c79843b","isMergeCommit":false,"messageTitle":"RejectCommand: Add reject command implementation","messageBody":"There is currently no way to mark a candidate as rejected\nor record why they were rejected.\n\nRecruiters need to reject candidates with a reason so\nthat rejection history is preserved for future reference.\n\nLet\u0027s add a RejectCommand that takes an index and a\nreason (r/ prefix), validates the input, checks for\narchived status, and creates a new Person with REJECTED\nstatus and the reason appended to the rejection history.\nSequential duplicate reasons trigger a warning message.\n\nCo-Authored-By: Claude Opus 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":228,"deletions":0}}},{"hash":"a418dea0d9a5765c32a547e325788b407c6fc8fa","isMergeCommit":false,"messageTitle":"RejectCommand: Add comprehensive tests","messageBody":"The new RejectCommand and RejectCommandParser lack test\ncoverage, and AddressBookParserTest does not verify that\nthe reject command is wired correctly.\n\nLet\u0027s add RejectCommandTest covering valid/invalid index\non filtered and unfiltered lists, archived candidate\nrejection, multiple rejections, sequential duplicate\nwarning, and status change verification. Add\nRejectCommandParserTest for format validation, boundary\ncases, and special character handling. Add\nRejectionReasonTest for value object validation. Update\nAddressBookParserTest with reject command routing test.\n\nCo-Authored-By: Claude Opus 4.6 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"test-code":{"insertions":445,"deletions":0}}},{"hash":"2a0f64288a813d39c1a92159e75dcbe9021a37c8","isMergeCommit":true,"messageTitle":"Merge branch \u0027claude/happy-noether\u0027 into branch-record-rejection","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"521d7ee4b19d3961b8b4e90a2909fec99f925b62","isMergeCommit":true,"messageTitle":"Merge pull request #46 from AK-matrix/branch-edit-candidate","messageBody":"EditCommand: Implement edit candidate MVP","fileTypesAndContributionMap":{}},{"hash":"9dfcd9b09a21a9494e0376af028e34796106aa9a","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 of https://github.com/AY2526S2-CS2103T-T17-4/tp into branch-record-rejection","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"25e2cac83e6abce136e76726fe6fd1ba6fb5a56a","isMergeCommit":false,"messageTitle":"Update RecordRejection feature","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":20,"deletions":2},"test-code":{"insertions":1,"deletions":1}}}]},{"date":"2026-03-18T00:00:00","commitResults":[{"hash":"bcc46603934afc20736610ebbcdb1bd3eed395a9","is