tributionMap":{}},{"hash":"91cb82bcf71e8d9d2af780ad8b171b7f5448f682","isMergeCommit":false,"messageTitle":"docs: update AboutUs for AK-matrix","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":4}}},{"hash":"26b55b3bb45bf2e17f48f956f6ba676a5eccf28f","isMergeCommit":true,"messageTitle":"Merge pull request #16 from AK-matrix/branch-update-AboutUs","messageBody":"Update AboutUs for Arnav","fileTypesAndContributionMap":{}},{"hash":"eea268b481a94b44412c851f5a2382fa0c09cc88","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into edit-userguide-shrie","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"a4bf263d991bcfa7d6844507fa433b2c241e7c29","isMergeCommit":true,"messageTitle":"Merge pull request #24 from shrievarshanbaskar/edit-userguide-shrie","messageBody":"Update AboutUs for Shrievarshan","fileTypesAndContributionMap":{}},{"hash":"23afb35998317c63a375813706d562ae43f48956","isMergeCommit":false,"messageTitle":"docs: Fix formatting in AboutUs page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}}]},{"date":"2026-03-06T00:00:00","commitResults":[{"hash":"973da5a8f3e69ffb0492334407a89f92f00142d2","isMergeCommit":false,"messageTitle":"docs: Add DG user stories and use cases","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":294,"deletions":48}}},{"hash":"9e86069268bb120e536b21de284a15c22f403879","isMergeCommit":false,"messageTitle":"docs: Format Appendix heading in Developer Guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}}]},{"date":"2026-03-07T00:00:00","commitResults":[{"hash":"550cbede7f445684e8dd2a768abfc2301db19913","isMergeCommit":false,"messageTitle":"docs: Add NFRs and glossary to DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":18,"deletions":8}}},{"hash":"aec868202db956e1bd56d34819dadc0802fbdf47","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-developer-guide\u0027 of https://github.com/AK-matrix/tp into branch-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"eca647f423f3edd0a7295874980146e24bb37a56","isMergeCommit":false,"messageTitle":"docs: Add additional user stories and use cases","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":17,"deletions":0}}},{"hash":"6966d54c32eb1562b0b83eff84af23c214d96688","isMergeCommit":false,"messageTitle":"docs: Remove irrelevant line in user stories","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":1}}}]},{"date":"2026-03-08T00:00:00","commitResults":[{"hash":"b32a914378c7cd23b130f416efe5cd1e828e9347","isMergeCommit":true,"messageTitle":"Merge pull request #34 from KeeZhiSong/add-ui-mockup","messageBody":"Update UI mockup","fileTypesAndContributionMap":{}}]},{"date":"2026-03-09T00:00:00","commitResults":[{"hash":"ebe483113b14b14e679eb613111692f8c949765f","isMergeCommit":false,"messageTitle":"docs: Remove placeholder text in AboutUs page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":10}}},{"hash":"1a3b1ecca8e04a4d19ec097c12e0732b8f435594","isMergeCommit":false,"messageTitle":"docs: Remove email in AboutUs Page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":2}}},{"hash":"63a9fe2921d36e2583d6538d66146d4052779afe","isMergeCommit":true,"messageTitle":"Merge pull request #38 from AK-matrix/branch-AboutUs","messageBody":"Remove email in AboutUs Page","fileTypesAndContributionMap":{}}]},{"date":"2026-03-10T00:00:00","commitResults":[{"hash":"0d3504f34b270b2bbab284fc81c1cd5e2cf048de","isMergeCommit":false,"messageTitle":"FindCommand: Implement candidate search MVP","messageBody":"FindCommand only searches the candidate\u0027s name and requires an exact\nfull-word match.\n\nRecruiters need a fast, forgiving search to retrieve records quickly\nusing fragments of info during high-pressure calls.\n\nLet\u0027s:\n* update the search algorithm to use case-insensitive substring\n  matching across Name, Phone, and Email fields\n* enforce MVP constraints like 150 characters max, 20 keywords max,\n  and valid symbol limits\n* update display messages to accurately reflect the filtered results\n\nThis provides the core candidate look-up capability. Replacing\nNameContainsKeywordsPredicate with an expanded\nNamePhoneEmailContainsKeywordsPredicate accurately reflects the new\nmulti-field search dimensions without disrupting existing architecture.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":87,"deletions":60},"test-code":{"insertions":164,"deletions":110}}},{"hash":"c7284ae3670c0dc6b4c8b830b8528045fdeb68ac","isMergeCommit":false,"messageTitle":"Update Domain constraints and test suites","messageBody":"There are new validation constraints required for candidate\ndetails editing in Talently.\n\nUpdating the validation regex rules and tests for Name,\nPhone, and Email improves the reliability of the system.\n\nAs a step towards implementing the EditCommand, let\u0027s update\nthe Domain classes (Name, Phone, Email, Person) and tests to\nenforce these new strict constraints. Doing so will make the\nsubsequent command logic easier to implement.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":25,"deletions":35},"test-code":{"insertions":32,"deletions":21}}},{"hash":"79a24756105ea859d88601ed357a572b0d190093","isMergeCommit":false,"messageTitle":"Edit Candidate Details (edit)","messageBody":"Allow a recruiter to update a candidate’s stored contact information\nwhen new or corrected details are obtained.\n\nCommand Format: edit INDEX [n/NAME] [p/PHONE] [e/EMAIL]\n(At least one field must be specified).\n\nParameters \u0026 Validation:\nINDEX: Must be a positive integer corresponding to a valid index\nin the currently displayed list. No leading zeros.\nTrimmed of whitespace.\n\nNAME (n/): 1-100 chars. Allowed: letters (A-Z, a-z), spaces,\nhyphens (-), apostrophes (\u0027), periods (.), and slashes (/).\nCase-sensitive for storage, case-insensitive for duplicate\nchecking. Collapse multiple consecutive spaces into a single\nspace during storage. Trim whitespace from start/end.\n\nPHONE (p/): 3-15 chars. Allowed: digits (0-9). Optional\n\u0027+\u0027 allowed ONLY as the first character. Trim whitespace.\n\nEMAIL (e/): Max length 254 chars. Standard AB3 format.\nCase-insensitive for storage and duplicate checking.\nTrim whitespace.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":30,"deletions":7},"test-code":{"insertions":24,"deletions":7}}}]},{"date":"2026-03-11T00:00:00","commitResults":[{"hash":"ed34c8c9ac2d226976ab3fa303c7557f56868b44","isMergeCommit":false,"messageTitle":"EditCommand: Remove Address and Tags functionality","messageBody":"As per requested by the user, the EditCommand no longer needs\nto track, parse, or update Address and Tag fields.\n\nRemoved these parameters from EditCommand usage messages, logic\nparsing in EditCommandParser, EditPersonDescriptor properties,\nand associated testing files.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":6,"deletions":76},"test-code":{"insertions":15,"deletions":90}}},{"hash":"307d2745cefdd300475a3355f9dee6a62b28de19","isMergeCommit":false,"messageTitle":"Remove Address and Tags from EditCommand subsystem","messageBody":"The edit command now only supports Name, Phone, and Email fields,\naligning with the Talently MVP specification: edit INDEX [n/NAME]\n[p/PHONE] [e/EMAIL].\n\nFiles changed in EditCommand subsystem:\n- EditCommand.java: Removed address/tags from EditPersonDescriptor,\n  createEditedPerson preserves original address/tags unchanged.\n- EditCommandParser.java: Only tokenizes n/, p/, e/ prefixes.\n- Messages.java: format() displays Name, Phone, Email only.\n\nTest files updated to match:\n- EditCommandTest, EditCommandParserTest, EditPersonDescriptorTest,\n  EditPersonDescriptorBuilder, PersonUtil, CommandTestUtil.\n\nNo changes to Person.java, AddCommand, DeleteCommand, or storage.\nAll existing address/tag data is preserved in the model and JSON.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":8},"other":{"insertions":580,"deletions":0},"test-code":{"insertions":6,"deletions":27}}},{"hash":"62e8757f310ee8e940c161a9238416812b4be845","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 of https://github.com/AY2526S2-CS2103T-T17-4/tp into branch-edit-candidate","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"ba545dfb13c9bb734308e338b8af855642690746","isMergeCommit":true,"messageTitle":"Merge pull request #48 from shrievarshanbaskar/branch-record-rejection","messageBody":"RejectCommand: Add RejectCommand implementation","fileTypesAndContributionMap":{}},{"hash":"45d80a6d0f824254333203d4ab1ae90cc4c33610","isMergeCommit":true,"messageTitle":"Merge pull request #42 from KeeZhiSong/add-candidate-#41","messageBody":"feat: Update add command with improved validation","fileTypesAndContributionMap":{}},{"hash":"98d49b2ab9147c63196b80dc06aa9dc3c0bc94d9","isMergeCommit":true,"messageTitle":"Merge pull request #40 from KeeZhiSong/list-candidates-#39","messageBody":"feat: Add list command to display all candidates","fileTypesAndContributionMap":{}}]},{"date":"2026-03-12T00:00:00","commitResults":[{"hash":"93d3ef6b07b575427cf6383582b2f05ba5717175","isMergeCommit":false,"messageTitle":"EditCommand: Add address parameter","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":29,"deletions":8},"test-code":{"insertions":46,"deletions":14}}},{"hash":"3e74ba459f63936e0db46969f713df21e7458b18","isMergeCommit":true,"messageTitle":"Merge pull request #54 from therealniru/sort-candidates","messageBody":"Add SortCommand to order candidates by date","fileTypesAndContributionMap":{}}]},{"date":"2026-03-17T00:00:00","commitResults":[{"hash":"1019e5be26e7dfc389fe0c547e60005b003c75a2","isMergeCommit":false,"messageTitle":"HelpCommand: Update link to user gui