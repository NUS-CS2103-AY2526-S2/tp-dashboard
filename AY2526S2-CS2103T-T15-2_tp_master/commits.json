dy":"","fileTypesAndContributionMap":{"test-code":{"insertions":0,"deletions":10}}}]},{"date":"2026-03-17T00:00:00","commitResults":[{"hash":"738d3a46f078dd990a0cafdfcba007756d384a60","isMergeCommit":true,"messageTitle":"Merge pull request #60 from songqiaoyuchen/lock-unlock","messageBody":"Implement mode switching foundation (lock/unlock)","fileTypesAndContributionMap":{}}]}],"IceyFoxes":[{"date":"2026-03-04T00:00:00","commitResults":[{"hash":"6465bbe02b0edce5fdd2a093e4ca358624c9f815","isMergeCommit":false,"messageTitle":"update about us documentation","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":5}}},{"hash":"78e20884f164bf000c7b49593445d216ced43766","isMergeCommit":true,"messageTitle":"Merge pull request #10 from IZO-Ong/update-aboutus-md","messageBody":"Change Johnny Doe to Isaac Ong in AboutUs.md","fileTypesAndContributionMap":{}},{"hash":"e99c8e939812173dbf78d70be49e4287ba90510e","isMergeCommit":true,"messageTitle":"Merge pull request #19 from IceyFoxes/change-about-us","messageBody":"update about us documentation to include kevin","fileTypesAndContributionMap":{}},{"hash":"2d016ab35c714a7b481e0e0b6ebebbf11a64f84a","isMergeCommit":false,"messageTitle":"update link of github actions build status badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"31ba9cf4980d6fb539c921e11f4de37cf5273790","isMergeCommit":false,"messageTitle":"update product scope","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":7,"deletions":5}}},{"hash":"6273282e5251220858e26e552f6b66492db3d55d","isMergeCommit":false,"messageTitle":"update DG glossary","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":0}}},{"hash":"70badbecb4f9d361ae69d8eb31d023d7da6b848d","isMergeCommit":true,"messageTitle":"Merge branch \u0027update-developer-guide\u0027 of github.com:IceyFoxes/tp into update-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"6f3af95d22e5e5adc34377cc70ade5aaf92e526e","isMergeCommit":true,"messageTitle":"Merge pull request #37 from IZO-Ong/update-readme","messageBody":"Change Facade to Dummy for standardisation of Glossary","fileTypesAndContributionMap":{}},{"hash":"aa53c98489f9c81f425e4e1d625ed3acf7a1b55d","isMergeCommit":true,"messageTitle":"Merge pull request #42 from IZO-Ong/nfr","messageBody":"Add additional non-functional requirements for security and stealth","fileTypesAndContributionMap":{}}]},{"date":"2026-03-14T00:00:00","commitResults":[{"hash":"06ff8be4b0603e33d4627022253c9a3c46f4102c","isMergeCommit":false,"messageTitle":"Refactor command flags from slash to dash format","messageBody":"Transitioned the application from legacy GUI-style prefixes (e.g., n/, p/)\nto standard CLI flags (e.g., -n, -p, -e, -a, -t) to provide a more\nfamiliar command-line experience.\n\nKey changes:\n* Core Syntax: Updated prefix definitions in `CliSyntax.java` to use the\n  new standard flags (without trailing spaces) to maintain compatibility\n  with the `ArgumentTokenizer` substring matching logic.\n* UI Formatting: Explicitly injected spacing in `MESSAGE_USAGE` strings\n  (`AddCommand`, `EditCommand`) to ensure help messages are visually\n  accurate and legible (e.g., `-n NAME` instead of `-nNAME`).\n* Test Infrastructure: Updated string builders in `CommandTestUtil.java`\n  and `PersonUtil.java` to correctly concatenate spaces between prefixes\n  and test data, ensuring all automated tests accurately simulate user input.\n* Documentation: Updated `UserGuide.md` and `DeveloperGuide.md` to reflect\n  the new flag formats globally.\n\nWhen transitioning to the new flags, an initial attempt to append a\ntrailing space directly into the prefix (e.g., `new Prefix(\"-n \")`)\ncaused test failures and parsing regressions.\n\nThe Underlying Cause:\n1. ArgumentTokenizer Matching: The underlying parsing engine\n   (`ArgumentTokenizer.findPrefixPosition`) relies on strict string\n   matching (`indexOf`). Defining the prefix with a trailing space breaks\n   parser flexibility (e.g., using tabs, multiple spaces, or no space\n   like `-njohn` causes the engine to fail to find the prefix).\n2. \"Empty Tag\" Edge Case: The `-t` tag prefix represents a special edge case.\n   To clear all tags from a contact, the command evaluates `edit 1 -t`\n   (with nothing after it). A strictly defined space (`\"-t \"`) causes\n   the parser to ignore the flag and fail to clear the tags.\n\nThe Solution:\nPrefixes in `CliSyntax` are kept completely strict, without trailing spaces\n(e.g., `\"-n\"`). This allows `ArgumentTokenizer` to successfully anchor the\nstart of the flag, safely utilizing its own inherent whitespace trimming.\nTo maintain correct visual formatting for users without breaking the engine\u0027s\nsubstring matching, spaces are explicitly added during UI string concatenations\nand Test string builders, isolating the formatting from the parser logic.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":42,"deletions":43},"docs":{"insertions":16,"deletions":16},"test-code":{"insertions":25,"deletions":25}}},{"hash":"4147b3b31d5ff2e83213833c17914b5bd27b7795","isMergeCommit":true,"messageTitle":"Merge branch \u0027change-command-flags\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"aee4b27f8c31f66797a597678265833550b2932e","isMergeCommit":false,"messageTitle":"Fix checkstyle errors","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":12,"deletions":11},"test-code":{"insertions":2,"deletions":1}}}]},{"date":"2026-03-15T00:00:00","commitResults":[{"hash":"e21f5714d246f96b1f65d4e53f895ef1a31b5461","isMergeCommit":true,"messageTitle":"Merge pull request #49 from Optimumspace5/new-GUI-layout","messageBody":"Refactor main window layout for new GUI structure","fileTypesAndContributionMap":{}}]},{"date":"2026-03-16T00:00:00","commitResults":[{"hash":"ceff3d5b987d53e1a2a0951b111a3c1bc55af19e","isMergeCommit":true,"messageTi